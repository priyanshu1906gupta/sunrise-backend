# Sunrise Coaching Khargone — production (GoDaddy cPanel)
# Copy this file to .env.production on the server, or paste the keys into
# cPanel → Setup Node.js App → Environment Variables.
# Replace every YOUR_* value before starting the app.

# Server
PORT=3000
NODE_ENV=production
PUBLIC_URL=https://YOUR_DOMAIN.com

# MySQL (cPanel → MySQL Databases)
DATABASE_URL="mysql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_MYSQL_HOST:3306/YOUR_DB_NAME"

# Auth — generate a long random JWT_SECRET (32+ characters). Do not reuse the local secret.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
IDLE_TIMEOUT_MS=21600000

# Frontend origin (CORS). Use your live site, comma-separated if you have www + apex.
CORS_ORIGIN=https://YOUR_DOMAIN.com
FRONTEND_URL=https://YOUR_DOMAIN.com

# SMTP — GoDaddy Workspace: smtpout.secureserver.net (not Titan).
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=admin@YOUR_DOMAIN.com
SMTP_PASS=YOUR_MAILBOX_PASSWORD
SMTP_FROM="Sunrise Coaching Khargone <admin@YOUR_DOMAIN.com>"

# Super-admin subscription page: /#/super-admin/<this-key>
SUPER_ADMIN_KEY=884420a297efd8d34a110511522db63efce6ab4a

# Uploads — GoDaddy Node.js Hosting (AiroApp)
# Do not set UPLOAD_BASE_DIR=[internal] or IMAGE_BASE_URL=https://YOUR_DOMAIN.com/...
# Leave these unset (or delete them in Settings → Secrets). Files go to public/assets.
# UPLOAD_BASE_DIR=
# IMAGE_BASE_URL=
# UPLOAD_URL_PATH=/assets
