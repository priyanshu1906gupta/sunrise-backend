generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  TEACHER
  STUDENT
}

enum EmployeeRole {
  MANAGER
  TEACHER
  STAFF
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PaymentStatus {
  PAID
  UNPAID
}

enum PaymentMode {
  CASH
  ONLINE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum NotificationType {
  STUDENT_PAYMENT
  EMPLOYEE_SALARY
  EXPENSE
  LIVE_CLASS
  STUDY_MATERIAL
  TEST
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum LiveSessionStatus {
  LIVE
  ENDED
}

enum AttendanceStatus {
  AVAILABLE
  LEAVE
  HALF_LEAVE
  HOLIDAY_CLOSE
  WEEKEND
}

enum DevicePlatform {
  WEB
  ANDROID
  IOS
  DESKTOP
}

enum NegativeFraction {
  HALF
  THIRD
  FOURTH
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
}

model Company {
  id                  String   @id @default(uuid())
  name                String
  ownerName           String   @map("owner_name")
  email               String
  phone               String
  bio                 String?  @db.Text
  logoFileId          String?  @map("logo_file_id")
  maxBranches         Int      @default(2) @map("max_branches")
  subscriptionStartAt DateTime @default(now()) @map("subscription_start_at")
  subscriptionEndAt   DateTime @default(now()) @map("subscription_end_at")
  active              Boolean  @default(true)
  sundayWeekend       Boolean  @default(false) @map("sunday_weekend")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  users         User[]
  branches      Branch[]
  files         File[]
  images        CompanyImage[]
  subjects      Subject[]
  schoolClasses SchoolClass[]
  boards        Board[]
  higherEd      HigherEdTrack[]

  @@index([subscriptionEndAt])
  @@index([active])
  @@map("companies")
}

model CompanyImage {
  id        String @id @default(uuid())
  companyId String @map("company_id")
  fileId    String @map("file_id")
  sortOrder Int    @default(0) @map("sort_order")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_images")
}

model Branch {
  id         String   @id @default(uuid())
  companyId  String   @map("company_id")
  name       String
  ownerName  String   @map("owner_name")
  managerId  String?  @map("manager_id")
  address    String?  @db.Text
  phone      String?
  details    String?  @db.Text
  logoFileId String?  @map("logo_file_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager   User?         @relation("BranchManager", fields: [managerId], references: [id], onDelete: SetNull)
  managers  User[]        @relation("ManagerBranch")
  photos    BranchPhoto[]
  students  Student[]
  employees Employee[]
  expenses  Expense[]
  courses      Course[]
  batches      Batch[]
  tests           Test[]
  liveSessions    LiveSession[]
  studyMaterials  StudyMaterial[]

  @@index([companyId])
  @@map("branches")
}

model BranchPhoto {
  id        String @id @default(uuid())
  branchId  String @map("branch_id")
  fileId    String @map("file_id")
  sortOrder Int    @default(0) @map("sort_order")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("branch_photos")
}

model User {
  id           String    @id @default(uuid())
  email        String?   @unique
  username     String?   @unique
  passwordHash String?   @map("password_hash")
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  phone        String?
  role         UserRole
  companyId    String    @map("company_id")
  branchId     String?   @map("branch_id")
  sessionEpoch Int       @default(0) @map("session_epoch")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation("ManagerBranch", fields: [branchId], references: [id], onDelete: SetNull)
  managedBranches Branch[]     @relation("BranchManager")
  notifications Notification[]
  employee      Employee?
  student       Student?
  refreshTokens RefreshToken[]
  deviceTokens  DeviceToken[]
  testsCreated          Test[]          @relation("TestsCreated")
  liveSessionsStarted   LiveSession[]   @relation("LiveSessionsStarted")
  studyMaterialsCreated StudyMaterial[] @relation("StudyMaterialsCreated")

  @@index([companyId])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime  @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model DeviceToken {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  token     String
  platform  DevicePlatform
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
  @@map("device_tokens")
}

model File {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  relativePath String   @map("relative_path")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  createdAt    DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("files")
}

model Subject {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  courses        CourseSubject[]
  employees      Employee[]
  liveSessions   LiveSession[]
  studyMaterials StudyMaterial[]

  @@unique([companyId, name])
  @@map("subjects")
}

model SchoolClass {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  students Student[]

  @@unique([companyId, name])
  @@map("school_classes")
}

model Board {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  students Student[]

  @@unique([companyId, name])
  @@map("boards")
}

model HigherEdTrack {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@map("higher_ed_tracks")
}

model Course {
  id             String   @id @default(uuid())
  branchId       String   @map("branch_id")
  name           String
  details        String?  @db.Text
  durationMonths Int      @map("duration_months")
  price          Decimal  @db.Decimal(12, 2)
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  branch   Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  subjects CourseSubject[]
  batches  Batch[]
  students     StudentCourse[]
  tests          Test[]
  liveSessions   LiveSession[]
  studyMaterials StudyMaterial[]

  @@index([branchId])
  @@index([deletedAt])
  @@map("courses")
}

model CourseSubject {
  courseId  String @map("course_id")
  subjectId String @map("subject_id")

  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([courseId, subjectId])
  @@map("course_subjects")
}

model Batch {
  id             String    @id @default(uuid())
  branchId       String    @map("branch_id")
  courseId       String    @map("course_id")
  name           String
  time           String?
  durationMonths Int       @map("duration_months")
  price          Decimal   @db.Decimal(12, 2)
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime  @map("end_date") @db.Date
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  branch   Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  course   Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  students StudentBatch[]

  @@index([branchId])
  @@index([courseId])
  @@index([deletedAt])
  @@map("batches")
}

model Student {
  id                   String         @id @default(uuid())
  branchId             String         @map("branch_id")
  userId               String?        @unique @map("user_id")
  photoFileId          String?        @map("photo_file_id")
  fullName             String         @map("full_name")
  gender               Gender
  dateOfBirth          DateTime?      @map("date_of_birth") @db.Date
  location             String?
  schoolClassId        String?        @map("school_class_id")
  boardId              String?        @map("board_id")
  courseCharge         Decimal        @map("course_charge") @db.Decimal(12, 2)
  registrationCharge   Decimal        @default(0) @map("registration_charge") @db.Decimal(12, 2)
  paymentAmount        Decimal        @map("payment_amount") @db.Decimal(12, 2)
  dueAmount            Decimal        @map("due_amount") @db.Decimal(12, 2)
  paymentDate          DateTime       @map("payment_date") @db.Date
  monthEndDate         DateTime       @map("month_end_date") @db.Date
  subscriptionStartAt  DateTime       @map("subscription_start_at") @db.Date
  subscriptionEndAt    DateTime       @map("subscription_end_at") @db.Date
  paymentStatus        PaymentStatus  @default(UNPAID) @map("payment_status")
  joiningDate          DateTime       @map("joining_date") @db.Date
  email                String?
  phone                String?
  emergencyContact     String?        @map("emergency_contact")
  status               StudentStatus  @default(ACTIVE)
  subscriptionMonths   Int            @default(1) @map("subscription_months")
  deletedAt            DateTime?      @map("deleted_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  schoolClass SchoolClass?     @relation(fields: [schoolClassId], references: [id], onDelete: SetNull)
  board       Board?           @relation(fields: [boardId], references: [id], onDelete: SetNull)
  payments    StudentPayment[]
  courses     StudentCourse[]
  batches     StudentBatch[]
  attempts    TestAttempt[]

  @@index([branchId])
  @@index([fullName])
  @@index([deletedAt])
  @@map("students")
}

model StudentCourse {
  studentId String @map("student_id")
  courseId  String @map("course_id")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([studentId, courseId])
  @@map("student_courses")
}

model StudentBatch {
  studentId String @map("student_id")
  batchId   String @map("batch_id")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([studentId, batchId])
  @@map("student_batches")
}

model StudentPayment {
  id             String      @id @default(uuid())
  studentId      String      @map("student_id")
  amount         Decimal     @db.Decimal(12, 2)
  paymentDate    DateTime    @map("payment_date") @db.Date
  dueAmountAfter Decimal     @map("due_amount_after") @db.Decimal(12, 2)
  mode           PaymentMode @default(CASH) @map("payment_mode")
  createdAt      DateTime    @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("student_payments")
}

model Employee {
  id               String       @id @default(uuid())
  branchId         String       @map("branch_id")
  userId           String?      @unique @map("user_id")
  photoFileId      String?      @map("photo_file_id")
  fullName         String       @map("full_name")
  gender           Gender
  role             EmployeeRole
  subjectId        String?      @map("subject_id")
  salary           Decimal      @db.Decimal(12, 2)
  salaryDate       DateTime     @map("salary_date") @db.Date
  joiningDate      DateTime     @map("joining_date") @db.Date
  email            String?
  phone            String
  emergencyContact String?      @map("emergency_contact")
  address          String?      @db.Text
  aadhaarFileId    String?         @map("aadhaar_file_id")
  status           EmployeeStatus  @default(ACTIVE)
  deletedAt        DateTime?       @map("deleted_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  branch     Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user       User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  subject    Subject?             @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  salaries   EmployeeSalary[]
  attendance EmployeeAttendance[]
  leaves     LeaveRequest[]

  @@index([branchId])
  @@index([deletedAt])
  @@map("employees")
}

model LeaveRequest {
  id         String   @id @default(uuid())
  employeeId String   @map("employee_id")
  fromDate   DateTime @map("from_date") @db.Date
  toDate     DateTime @map("to_date") @db.Date
  reason     String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("leave_requests")
}

model EmployeeAttendance {
  id         String           @id @default(uuid())
  employeeId String           @map("employee_id")
  date       DateTime         @db.Date
  status     AttendanceStatus
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@map("employee_attendance")
}

model EmployeeSalary {
  id          String   @id @default(uuid())
  employeeId  String   @map("employee_id")
  amount      Decimal  @db.Decimal(12, 2)
  paymentDate DateTime @map("payment_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_salaries")
}

model Expense {
  id        String   @id @default(uuid())
  branchId  String   @map("branch_id")
  name      String
  dueDate   DateTime @map("due_date") @db.Date
  amount    Decimal  @db.Decimal(12, 2)
  comment   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@map("expenses")
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@map("otps")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  entityId  String           @map("entity_id")
  branchId  String?          @map("branch_id")
  dueDate   DateTime         @map("due_date") @db.Date
  read      Boolean          @default(false)
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, entityId, dueDate])
  @@index([userId, read])
  @@index([userId, readAt])
  @@map("notifications")
}

model AppContent {
  id        String   @id @default(uuid())
  key       String   @unique
  title     String
  body      String   @db.Text
  email     String?
  phone     String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_contents")
}

model LiveSession {
  id          String            @id @default(uuid())
  branchId    String            @map("branch_id")
  courseId    String            @map("course_id")
  subjectId   String            @map("subject_id")
  startedById String            @map("started_by_id")
  status      LiveSessionStatus
  jitsiRoom   String            @unique @map("jitsi_room")
  startedAt   DateTime          @default(now()) @map("started_at")
  endedAt     DateTime?         @map("ended_at")

  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  startedBy User    @relation("LiveSessionsStarted", fields: [startedById], references: [id], onDelete: Restrict)

  @@index([branchId, status])
  @@index([courseId, subjectId, status])
  @@map("live_sessions")
}

model StudyMaterial {
  id          String    @id @default(uuid())
  branchId    String    @map("branch_id")
  courseId    String    @map("course_id")
  subjectId   String    @map("subject_id")
  name        String
  fileId      String    @map("file_id")
  createdById String    @map("created_by_id")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  createdBy User    @relation("StudyMaterialsCreated", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([branchId])
  @@index([courseId, subjectId])
  @@index([deletedAt])
  @@map("study_materials")
}

model Test {
  id               String            @id @default(uuid())
  name             String
  courseId         String            @map("course_id")
  branchId         String            @map("branch_id")
  durationMinutes  Int               @map("duration_minutes")
  questionCount    Int               @map("question_count")
  totalMarks       Int               @map("total_marks")
  negativeEnabled  Boolean           @default(false) @map("negative_enabled")
  negativeFraction NegativeFraction? @map("negative_fraction")
  createdById      String            @map("created_by_id")
  deletedAt        DateTime?         @map("deleted_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdBy User           @relation("TestsCreated", fields: [createdById], references: [id], onDelete: Restrict)
  questions TestQuestion[]
  attempts  TestAttempt[]

  @@index([branchId])
  @@index([courseId])
  @@index([deletedAt])
  @@map("tests")
}

model TestQuestion {
  id                String @id @default(uuid())
  testId            String @map("test_id")
  sortOrder         Int    @map("sort_order")
  subjectName       String @map("subject_name")
  questionEn        String @map("question_en") @db.Text
  questionHi        String @map("question_hi") @db.Text
  options           Json
  correctIndex      Int    @map("correct_index")
  answerDescription String @map("answer_description") @db.Text

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId, sortOrder])
  @@map("test_questions")
}

model TestAttempt {
  id               String        @id @default(uuid())
  studentId        String        @map("student_id")
  testId           String        @map("test_id")
  startedAt        DateTime      @map("started_at")
  submittedAt      DateTime?     @map("submitted_at")
  status           AttemptStatus @default(IN_PROGRESS)
  remainingSeconds Int           @map("remaining_seconds")
  answers          Json
  marksObtained    Decimal?      @map("marks_obtained") @db.Decimal(10, 4)
  warningCount     Int           @default(0) @map("warning_count")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test    Test    @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([studentId, testId])
  @@index([testId])
  @@index([studentId])
  @@map("test_attempts")
}
