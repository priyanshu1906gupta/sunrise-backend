# Server
PORT=3000
NODE_ENV=development
PUBLIC_URL=http://localhost:3000

# MySQL (XAMPP default: user root, empty password)
DATABASE_URL="mysql://root:@localhost:3306/sunrise_coaching"

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
IDLE_TIMEOUT_MS=21600000

# Frontend (production only — development allows all origins)
CORS_ORIGIN=http://localhost:4200
FRONTEND_URL=http://localhost:4200

# SMTP — GoDaddy Workspace Email uses smtpout.secureserver.net (not smtp.titan.email).
# Port 465 SSL or 587 STARTTLS. SMTP auth must be on or you get 550/553 Relay Denied.
# Titan mailboxes use smtp.titan.email instead; if 2FA is on, use an Application Password.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# SMTP_APP_PASS=
SMTP_FROM="Sunrise Coaching Khargone <admin@your-domain.com>"

# Help & Support contact (shown on Help page; query emails go here)
SUPPORT_EMAIL=admin@online-business-erp.com
SUPPORT_PHONE=7898356505

# Super-admin subscription page (append this key to the URL)
SUPER_ADMIN_KEY=884420a297efd8d34a110511522db63efce6ab4a

# FCM (optional — device tokens are stored even without this key)
# FCM_SERVER_KEY=

# Uploads — local: ./assets/{companyId}/ served at /assets/...
UPLOAD_BASE_DIR=./assets
# IMAGE_BASE_URL=
# UPLOAD_URL_PATH=/assets
#
# GoDaddy Node.js Hosting (AiroApp): do not set UPLOAD_BASE_DIR to [internal]
# or a cPanel public_html path. Leave these unset — the app writes to
# public/assets (that folder survives deploys) and serves files at /assets/...
#
# Classic cPanel Node app only:
# UPLOAD_BASE_DIR=/home/YOUR_CPANEL_USER/public_html/uploads
# IMAGE_BASE_URL=https://yourdomain.com/uploads
